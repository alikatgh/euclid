{
  "name": "euclid",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-licenses.mjs && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "pretest": "mkdir -p node_modules/.bin && ln -sf \"$(which python3 2>/dev/null || which python 2>/dev/null || echo python3)\" node_modules/.bin/python",
    "test": "node --test src/lib/*.test.mjs"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "framer-motion": "^14.0.0",
    "katex": "^0.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "description": "Euclid: learn algorithms through connected geometry, mathematical writing, and code.",
  "license": "MIT"
}
